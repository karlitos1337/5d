### Task 5.3: Rate Limiting für APIs
// In modules/api-fetcher.js erweitern:

class RateLimiter {
constructor(maxRequests, perMilliseconds) {
this.maxRequests = maxRequests;
this.perMilliseconds = perMilliseconds;
this.requests = [];
}

async throttle() {
const now = Date.now();
this.requests = this.requests.filter(time => now - time < this.perMilliseconds);

text
if (this.requests.length >= this.maxRequests) {
  const oldestRequest = this.requests;
  const waitTime = this.perMilliseconds - (now - oldestRequest);
  await new Promise(resolve => setTimeout(resolve, waitTime));
  return this.throttle();
}

this.requests.push(now);
}
}

const worldBankLimiter = new RateLimiter(5, 1000); // 5 Requests pro Sekunde

async function fetchWorldBankData() {
await worldBankLimiter.throttle();
// ... fetch logic
}

