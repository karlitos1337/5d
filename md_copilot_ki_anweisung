const CACHE_TTL = 3600000; // 1 Stunde in ms
let cache = loadFromLocalStorage() || {};

export async function fetchAllData() {
    const data = {};
    
    // 1. Depression Data (WHO/Our World in Data)
    data.depression = await fetchWithCache(
        'depression',
        'https://ourworldindata.org/grapher/depression-prevalence.csv',
        parseCSV
    );
    
    // 2. Dropout Data (World Bank)
    data.dropout = await fetchWithCache(
        'dropout',
        'https://api.worldbank.org/v2/indicator/SE.PRM.DROPOUT.ZS?format=json&per_page=300',
        parseWorldBankJSON
    );
    
    // 3. Life Satisfaction (OECD)
    data.lifeSatisfaction = await fetchWithCache(
        'lifeSatisfaction',
        'https://stats.oecd.org/restsdmx/sdmx.ashx/GetData/BLI/...', // Anpassen
        parseOECDData
    );
    
    // 4. Alternative Schools (statisch)
    data.schools = await fetch('./data/schools.json').then(r => r.json());
    
    return data;
}

async function fetchWithCache(key, url, parser) {
    // Check Cache
    if (cache[key] && cache[key].timestamp > Date.now() - CACHE_TTL) {
        console.log(`Using cached data for ${key}`);
        return cache[key].data;
    }
    
    // Fetch neu
    try {
        const response = await fetch(url);
        const rawData = await response.text();
        const parsedData = parser(rawData);
        
        // Cache speichern
        cache[key] = {
            data: parsedData,
            timestamp: Date.now()
        };
        saveToLocalStorage(cache);
        
        return parsedData;
    } catch (error) {
        console.error(`Error fetching ${key}:`, error);
        
        // Fallback zu altem Cache
        if (cache[key]) {
            console.warn(`Using stale cache for ${key}`);
            return cache[key].data;
        }
        
        return null;
    }
}

function parseCSV(csv) {
    // Einfacher CSV-Parser
    const lines = csv.split('\n');
    const headers = lines.split(',');
    
    return lines.slice(1).map(line => {
        const values = line.split(',');
        const obj = {};
        headers.forEach((header, i) => {
            obj[header] = values[i];
        });
        return obj;
    });
}

function parseWorldBankJSON(json) {
    const data = JSON.parse(json);
    return data; // World Bank API hat Meta in , Daten in[1]
}

