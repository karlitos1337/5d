export function createHeatmapLayer(depressionData, dropoutData) {
    // Kombiniere Depression & Dropout zu Heatmap-Punkten
    const points = [];
    
    depressionData.forEach(country => {
        const dropout = dropoutData.find(d => d.countryiso3code === country.Code);
        
        if (country.Latitude && country.Longitude) {
            // Intensität = (Depression + Dropout) / 2
            const intensity = (
                parseFloat(country.Value) + 
                (dropout ? parseFloat(dropout.value) : 0)
            ) / 2;
            
            points.push([
                parseFloat(country.Latitude),
                parseFloat(country.Longitude),
                intensity / 100 // Normalize zu 0-1
            ]);
        }
    });
    
    return L.heatLayer(points, {
        radius: 25,
        blur: 15,
        maxZoom: 17,
        gradient: {
            0.0: '#22C55E', // Grün
            0.5: '#E8814A', // Orange
            1.0: '#C0152F'  // Rot
        }
    });
}

export function createSchoolMarkers(schools) {
    const markerGroup = L.layerGroup();
    
    schools.forEach(school => {
        const icon = L.divIcon({
            className: `school-marker school-marker--${school.type}`,
            html: getIconForType(school.type),
            iconSize: 
        });
        
        const marker = L.marker([school.lat, school.lng], { icon })
            .bindPopup(createSchoolPopup(school));
        
        markerGroup.addLayer(marker);
    });
    
    return markerGroup;
}

export function createIMPLayer(data) {
    // Berechne IMP-Score pro Land
    const countries = calculateIMPScores(data);
    
    // Erstelle Choropleth (benötigt GeoJSON)
    return L.geoJSON(countriesGeoJSON, {
        style: (feature) => {
            const country = countries.find(c => c.code === feature.properties.iso_a3);
            const imp = country ? country.impScore : 0.5;
            
            return {
                fillColor: getColorForIMP(imp),
                weight: 1,
                opacity: 1,
                color: 'white',
                fillOpacity: 0.7
            };
        },
        onEachFeature: (feature, layer) => {
            const country = countries.find(c => c.code === feature.properties.iso_a3);
            layer.bindPopup(createIMPPopup(country));
        }
    });
}

function calculateIMPScores(data) {
    // IMP = A × IM × R × SP × Au
    return data.countries.map(country => {
        const autonomy = 1 - (country.centralizationIndex / 100);
        const intrinsic = 1 - (country.externalPressure / 100);
        const resilience = 1 - (country.depressionRate / 100);
        const participation = country.democraticIndex / 100;
        const authenticity = country.lifeSatisfaction / 10;
        
        return {
            ...country,
            impScore: autonomy * intrinsic * resilience * participation * authenticity
        };
    });
}

function getColorForIMP(imp) {
    if (imp >= 0.7) return '#22C55E'; // Grün
    if (imp >= 0.5) return '#E8814A'; // Orange
    return '#C0152F'; // Rot
}

function getIconForType(type) {
    const icons = {
        'sudbury': '🟢',
        'waldorf': '🔵',
        'folk-high': '🟡',
        'tokkatsu': '🟣'
    };
    return icons[type] || '⚪';
}

function createSchoolPopup(school) {
    return `
        <div class="school-popup">
            <h3>${school.name}</h3>
            <p><strong>Typ:</strong> ${school.type}</p>
            <p><strong>Gegründet:</strong> ${school.founded}</p>
            <p><strong>Schüler:</strong> ${school.students}</p>
            <hr>
            <p><strong>Outcomes:</strong></p>
            <ul>
                <li>College-Rate: ${school.outcomes.college}%</li>
                <li>Zufriedenheit: ${school.outcomes.satisfaction}%</li>
            </ul>
            <a href="${school.detailsLink}" target="_blank">Mehr erfahren →</a>
        </div>
    `;
}

function createIMPPopup(country) {
    return `
        <div class="imp-popup">
            <h3>${country.name}</h3>
            <p><strong>IMP-Score:</strong> ${country.impScore.toFixed(2)}</p>
            <canvas id="radar-${country.code}" width="200" height="200"></canvas>
            <script>
                // Chart.js Radar Chart
                new Chart(document.getElementById('radar-${country.code}'), {
                    type: 'radar',
                    data: {
                        labels: ['Autonomie', 'Intrinsisch', 'Resilienz', 'Partizipation', 'Authentizität'],
                        datasets: [{
                            data: [
                                ${country.autonomy},
                                ${country.intrinsic},
                                ${country.resilience},
                                ${country.participation},
                                ${country.authenticity}
                            ],
                            backgroundColor: 'rgba(33, 128, 141, 0.2)',
                            borderColor: 'rgba(33, 128, 141, 1)',
                            borderWidth: 2
                        }]
                    },
                    options: {
                        scales: {
                            r: { min: 0, max: 1 }
                        }
                    }
                });
            </script>
        </div>
    `;
}
