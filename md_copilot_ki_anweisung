function checkBrowserSupport() {
const required = {
'localStorage': typeof Storage !== 'undefined',
'fetch': typeof fetch === 'function',
'Promise': typeof Promise !== 'undefined',
'modules': 'noModule' in HTMLScriptElement.prototype
};

const missing = Object.entries(required)
.filter(([_, supported]) => !supported)
.map(([name]) => name);

if (missing.length > 0) {
console.error('Browser nicht unterstützt. Fehlende Features:', missing);
alert(Ihr Browser ist veraltet. Bitte aktualisieren Sie: ${missing.join(', ')});
return false;
}
return true;
}

// In app.js vor init() aufrufen
if (!checkBrowserSupport()) {
document.body.innerHTML = '<h1>Browser nicht unterstützt</h1><p>Bitte verwenden Sie Chrome, Firefox, Safari oder Edge (neueste Version).</p>';
throw new Error('Browser not supported');
}

